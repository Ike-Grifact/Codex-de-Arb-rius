---
import { withBase } from "../../lib/paths";
const destino = withBase("personagens/", import.meta.env.BASE_URL);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,follow" />
  <meta http-equiv="refresh" content={"0; url=" + destino} />
  <link rel="canonical" href={destino} />
  <title>Personagens | Codex de Árborius</title>
</head>
<body>
  <p>As biografias estão em <a href={destino}>Personagens</a>.</p>
  <script define:vars={{destino}}>
    const antigo = decodeURIComponent(location.hash.slice(1));
    const slug = /^[a-z0-9-]+$/.test(antigo) ? antigo + "/" : "";
    location.replace(destino + slug);
  </script>
</body>
</html>
