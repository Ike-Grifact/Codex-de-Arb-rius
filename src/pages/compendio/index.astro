---
import { getCollection } from "astro:content";
import PortalLayout from "../../layouts/PortalLayout.astro";
import CompendiumCard from "../../components/CompendiumCard.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import NavigationIcon from "../../components/NavigationIcon.astro";
import {
  availabilityLabel,
  availabilityLabels,
  categoryLabel,
  categoryLabels,
  originLabel,
  originLabels,
  ptBrCollator,
  tagLabel,
  tagLabels,
  typeLabel
} from "../../data/taxonomy";

const materials = (await getCollection("materiais"))
  .filter((entry) => entry.data.visibility === "publico" && entry.data.status === "publicado")
  .map((entry) => ({
    ...entry.data,
    categoryId: "material",
    space: undefined
  }));
const items = (await getCollection("itens"))
  .filter((entry) => entry.data.visibility === "publico" && entry.data.status === "publicado")
  .map((entry) => ({
    ...entry.data,
    categoryId: entry.data.category
  }));
const entries = [...materials, ...items].sort((left, right) =>
  ptBrCollator.compare(left.title, right.title)
);

const unique = (values: string[]) => [...new Set(values)];
const categoryIds = unique(entries.map((entry) => entry.categoryId))
  .sort((left, right) => ptBrCollator.compare(categoryLabel(left), categoryLabel(right)));
const tagIds = unique(entries.flatMap((entry) => entry.tags))
  .sort((left, right) => ptBrCollator.compare(tagLabel(left), tagLabel(right)));
const availabilityIds = unique(entries.map((entry) => entry.availability))
  .sort((left, right) => ptBrCollator.compare(availabilityLabel(left), availabilityLabel(right)));
const originIds = unique(entries.map((entry) => entry.origin))
  .sort((left, right) => ptBrCollator.compare(originLabel(left), originLabel(right)));
const referenceCategories = [
  "material", "arma", "armadura", "ferramenta", "consumivel", "provisao",
  "abrigo", "montaria", "kit", "municao", "projeto", "item"
];
---

<PortalLayout title="Compêndio" description="Materiais e equipamentos públicos do Codex de Árborius.">
  <div class="page-container">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Referência estruturada</p>
        <h1 class="area-title"><NavigationIcon name="compendio" /> Compêndio</h1>
        <p>Cada verbete alimenta esta listagem, o guia, a busca e sua própria exportação.</p>
      </div>
      <div class="library-counter">
        <strong>{String(entries.length).padStart(2, "0")}</strong>
        <span>verbetes<br />públicos</span>
      </div>
    </header>

    <details class="filter-panel no-print" open>
      <summary><CategoryIcon name="item" /> Filtros do Compêndio</summary>
      <div class="filter-bar" aria-label="Filtros do compêndio">
        <label>
          <span>Tipo</span>
          <select data-filter="type">
            <option value="">Todos</option>
            <option value="material">{typeLabel("material")}</option>
            <option value="item">{typeLabel("item")}</option>
          </select>
        </label>
        <label>
          <span><CategoryIcon name="item" size="small" /> Categoria</span>
          <select data-filter="category">
            <option value="">Todas</option>
            {categoryIds.map((id) => <option value={id}>{categoryLabel(id)}</option>)}
          </select>
        </label>
        <label>
          <span>Tag</span>
          <select data-filter="tag">
            <option value="">Todas</option>
            {tagIds.map((id) => <option value={id}>{tagLabel(id)}</option>)}
          </select>
        </label>
        <label>
          <span>Disponibilidade</span>
          <select data-filter="availability">
            <option value="">Todas</option>
            {availabilityIds.map((id) => <option value={id}>{availabilityLabel(id)}</option>)}
          </select>
        </label>
        <label>
          <span>Origem</span>
          <select data-filter="origin">
            <option value="">Todas</option>
            {originIds.map((id) => <option value={id}>{originLabel(id)}</option>)}
          </select>
        </label>
        <label class="filter-search">
          <span>Nome</span>
          <input type="search" data-filter="text" placeholder="Ex.: água, seda…" />
        </label>
        <button type="button" data-clear-filters>Limpar</button>
      </div>
    </details>

    <p class="filter-count" aria-live="polite"><span data-visible-count>{entries.length}</span> verbetes exibidos</p>

    <div class="compendium-grid">
      {entries.map((entry) => (
        <CompendiumCard
          title={entry.title}
          slug={entry.slug}
          description={entry.description}
          type={entry.type}
          category={entry.type === "material" ? entry.category : entry.categoryId}
          availability={entry.availability}
          tags={entry.tags}
          origin={entry.origin}
          space={entry.space}
        />
      ))}
    </div>
    <div class="empty-state" data-filter-empty hidden>
      <NavigationIcon name="compendio" size="large" />
      <h3>Nenhum verbete encontrado</h3>
      <p>Ajuste ou limpe os filtros para ver o acervo público.</p>
    </div>

    <section class="category-reference">
      <p class="eyebrow">Referência rápida</p>
      <h2>Categorias do Compêndio</h2>
      <div class="category-reference__grid">
        {referenceCategories.map((id) => (
          <span>
            <CategoryIcon name={id} />
            {categoryLabel(id)}
          </span>
        ))}
      </div>
      <p>Categorias sem verbetes permanecem como estrutura visual até receberem conteúdo público validado.</p>
    </section>
  </div>
</PortalLayout>

<script>
  const panel = document.querySelector<HTMLDetailsElement>(".filter-panel");
  if (panel && window.matchMedia("(max-width: 760px)").matches) panel.open = false;

  const controls = [...document.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-filter]")];
  const entries = [...document.querySelectorAll<HTMLElement>("[data-filter-entry]")];
  const counter = document.querySelector<HTMLElement>("[data-visible-count]");
  const empty = document.querySelector<HTMLElement>("[data-filter-empty]");

  const applyFilters = () => {
    const values = Object.fromEntries(
      controls.map((control) => [control.dataset.filter, control.value.toLocaleLowerCase("pt-BR").trim()])
    );
    let visible = 0;
    entries.forEach((entry) => {
      const matches =
        (!values.type || entry.dataset.type === values.type) &&
        (!values.category || entry.dataset.category === values.category) &&
        (!values.tag || entry.dataset.tags?.includes(`|${values.tag}|`)) &&
        (!values.availability || entry.dataset.availability === values.availability) &&
        (!values.origin || entry.dataset.origin === values.origin) &&
        (!values.text || entry.dataset.title?.includes(values.text));
      entry.hidden = !matches;
      if (matches) visible += 1;
    });
    if (counter) counter.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
  };

  controls.forEach((control) => control.addEventListener("input", applyFilters));
  document.querySelector("[data-clear-filters]")?.addEventListener("click", () => {
    controls.forEach((control) => (control.value = ""));
    applyFilters();
  });
</script>
