---
import {apoloMaestrias,apoloGrupos} from "../../../data/apolo-maestrias.mjs";
import {withBase} from "../../../lib/paths";
import ApoloRuleSidebar from "../../../components/ApoloRuleSidebar.astro";
import "../../../styles/apolo-rule-cards.css";
const base=import.meta.env.BASE_URL;
---
<html lang="pt-BR">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Fichas individuais, resumidas e coloridas das Maestrias de Apolo Hellman para consulta rápida em Assimilação RPG."/>
<meta name="theme-color" content="#193d33"/>
<title>Maestrias de Apolo — Fichas Rápidas | Codex de Árborius</title>
<link rel="icon" type="image/svg+xml" href={withBase("symbols/maestria-araucaria-coroa.svg",base)}/></head>
<body><div class="rule-shell">
<ApoloRuleSidebar/>
<main class="rule-page">
<div class="rule-topbar"><span>Codex / Jogadores / Apolo Hellman</span><a href={withBase("dossies/apolo-hellman-f943e1efaaa2.html",base)}>Abrir guia completo</a></div>
<header class="rule-intro"><p class="rule-eyebrow">Árborius · Compêndio do jogador</p>
<div class="rule-masthead"><img src={withBase("symbols/maestria-araucaria-coroa.svg",base)} alt="Araucária coroada, emblema das Maestrias"/><h1 class="rule-title">Maestrias de Apolo</h1></div>
<p class="rule-lead">A versão de leitura rápida das três Maestrias. Escolha uma capacidade para consultar <strong>custo, condição, efeito e limites</strong>, mantendo a explicação completa no guia original.</p>
<p class="rule-annotation">Economia experimental PO/PM · SRD de Árborius v1.29 · 15 fichas · Não substitui o texto integral</p>
</header>
<div class="rule-footer"><a class="rule-button rule-button--primary" href={withBase("dossies/apolo-hellman-f943e1efaaa2.html",base)}>Ler o dossiê ilustrado e as Maestrias</a><a class="rule-button" href={withBase("regras/",base)}>Consultar ações, regras e recursos</a></div>
<section class="rule-paper" aria-label="Resumo da economia pessoal">
<div class="rule-paper-head"><p>Economia compartilhada de Apolo</p><div class="rule-cost-row"><span class="rule-cost rule-cost--pm"><strong>2 / 4 / 6 PM</strong><small>Maestrias I / II / III</small></span><span class="rule-cost rule-cost--assim"><strong>3e</strong><small>Recupera 1 PM em Conflito</small></span><span class="rule-cost rule-cost--risk"><strong>2d</strong><small>Recupera 1 PM em Conflito</small></span></div></div>
<div class="rule-body"><section class="rule-effect"><h2>O que é gratuito?</h2><p><strong>Observar, deduzir, planejar e usar passivas</strong> não custa PM por si só. PM paga técnicas excepcionais convertidas; quando há rolagem, permite manter um dado a mais dentre os já rolados, até o teto usual de quatro.</p></section><section class="rule-effect"><h2>Quando o PM volta?</h2><p><strong>+1 PM por nova cena significativa.</strong> Apenas durante Conflito, <strong>2d ou 3e recuperam 1 PM próprio</strong>, uma vez por rodada e sem gastar Ação. Recuperações não ultrapassam o máximo; PM não são transferidos por regra geral.</p></section></div>
</section>
{apoloGrupos.map(grupo=>(
<section class="rule-collection" aria-label={grupo.name}>
  <div class="rule-group-heading"><h2>{grupo.name}</h2><p>{grupo.description}</p></div>
  <div class="rule-cards">
  {apoloMaestrias.filter(item=>item.stage===grupo.stage).map(item=><a class="rule-index-card" href={withBase(`maestrias/apolo/${item.slug}/`,base)}><span class="rule-index-kicker">{item.kind}</span><strong>{item.name}</strong><p>{item.headline}</p><span class="rule-cost-row">{item.costs.slice(0,3).map(cost=><span class={`rule-cost rule-cost--${cost.type}`}><b>{cost.value}</b><small>{cost.label}</small></span>)}</span></a>)}
  </div>
</section>
))}
<div class="rule-footer"><a class="rule-button rule-button--primary" href={withBase("dossies/apolo-hellman-f943e1efaaa2.html",base)}>Ler o dossiê completo de Apolo</a><a class="rule-button" href={withBase("",base)}>Voltar ao Codex</a></div>
</main></div></body></html>