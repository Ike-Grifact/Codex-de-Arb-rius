---
import {referenciasArborius,tiposReferencia} from "../../data/arborius-references.mjs";
import {withBase} from "../../lib/paths";
import ReferenceSidebar from "../../components/ReferenceSidebar.astro";
import "../../styles/apolo-rule-cards.css";
import "../../styles/linked-rules.css";
export function getStaticPaths(){return referenciasArborius.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
const base=import.meta.env.BASE_URL;
const type=tiposReferencia[item.type];
const related=referenciasArborius.filter(x=>item.related?.includes(x.slug));
---
<html lang="pt-BR">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={item.lead}/><meta name="theme-color" content="#193d33"/>
<title>{item.title} — {type.title} | Codex de Árborius</title>
<link rel="icon" type="image/svg+xml" href={withBase("symbols/maestria-araucaria-coroa.svg",base)}/></head>
<body><div class="rule-shell">
<ReferenceSidebar current={item.slug}/>
<main class="rule-page">
<div class="rule-topbar"><span>Codex / Regras / {type.title}</span><a href={withBase("maestrias/apolo/capitulo/",base)}>Ler capítulo de Apolo</a></div>
<header class="rule-intro">
<p class="rule-eyebrow"><span class={`rule-kind rule-kind--${item.type}`}>{type.title}</span> {type.hint} · {item.origin}</p>
<h1 class="rule-title">{item.title}</h1><p class="rule-lead">{item.lead}</p>
<p class="rule-annotation">Fonte: {item.source} · Texto de consulta condensado, não substitui o livro.</p>
</header>
<article class={`rule-paper rule-paper--${item.type}`}>
<div class="rule-paper-head rule-ref-head"><p>Referência mecânica · {type.title}</p><span class={`rule-kind rule-kind--${item.type}`}>{type.title}</span></div>
<dl class="rule-stats">{item.fields.map(row=><div class="rule-stat"><dt>{row[0]}</dt><dd>{row[1]}</dd></div>)}</dl>
<div class="rule-body">
<section class="rule-effect"><h2>Como funciona</h2>
<ol class="rule-procedure">{item.steps.map((step,i)=><li><strong>{String(i+1).padStart(2,"0")}</strong><span>{step}</span></li>)}</ol></section>
</div>
<div class="rule-warning"><strong>Limitação</strong><span>{item.limit}</span></div>
</article>
<section class="rule-collection">
<h2>Referências relacionadas</h2>
<div class="rule-reference-grid">{related.map(ref=><a href={withBase(`regras/${ref.slug}/`,base)} class={`rule-ref-tile rule-ref-tile--${ref.type}`} data-codex-ref="true" data-ref-type={ref.type} data-ref-title={ref.title} data-ref-summary={ref.lead} data-ref-label={tiposReferencia[ref.type].title} data-ref-cost={ref.fields?.[0]?.[1]||""}><span class={`rule-kind rule-kind--${ref.type}`}>{tiposReferencia[ref.type].title}</span><strong>{ref.title}</strong><small>{ref.lead}</small></a>)}</div>
</section>
<div class="rule-footer"><a class="rule-button rule-button--primary" href={withBase("maestrias/apolo/capitulo/",base)}>Voltar ao capítulo de Apolo</a><a class="rule-button" href={withBase("regras/",base)}>Índice das regras</a></div>
</main></div>
<script src={withBase("dossies/assets/linked-references.js",base)} defer></script>
</body></html>