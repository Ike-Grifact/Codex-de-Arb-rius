---
import { getCollection } from "astro:content";
import PortalLayout from "../layouts/PortalLayout.astro";
import GuideCard from "../components/GuideCard.astro";
import QuestCard from "../components/QuestCard.astro";
import SessionCard from "../components/SessionCard.astro";
import { withBase } from "../lib/paths";
import NavigationIcon from "../components/NavigationIcon.astro";

const base = import.meta.env.BASE_URL;
const guides = (await getCollection("guias"))
  .filter((entry) => entry.data.visibility === "publico" && entry.data.status === "publicado")
  .sort((a, b) => a.data.order - b.data.order);
const quests = (await getCollection("quests"))
  .filter((entry) => entry.data.visibility === "publico" && entry.data.status === "publicado");
const sessions = (await getCollection("sessoes"))
  .filter((entry) => entry.data.visibility === "publico" && entry.data.status === "publicado");

const sections = [
  ["biblioteca/", "Biblioteca", "Guias completos para leitura e exportação.", "biblioteca"],
  ["compendio/", "Compêndio", "Materiais, itens e referências rápidas.", "compendio"],
  ["escudo-do-mestre/", "Escudo do Mestre", "Tabelas rápidas de Assimilação RPG para mesa e impressão A4.", "compendio"],
  ["mundo/", "Mundo", "Lugares, povos e cronologia pública.", "mundo"],
  ["quests/", "Quests", "Objetivos e estados acompanhados pela campanha.", "quests"],
  ["cronicas/", "Crônicas", "Memória organizada das sessões.", "cronicas"],
  ["laboratorio/", "Laboratório", "Protótipos locais e recursos beta.", "laboratorio"],
  ["assimilador/", "Área do Assimilador", "Ponto de acesso para o acervo privado.", "assimilador"]
] as const;
---

<PortalLayout
  title="Codex de Árborius"
  description="Portal público para leitura, consulta e memória da campanha de Árborius."
>
  <div class="page-container home-page">
    <section class="hero-panel">
      <div class="hero-panel__copy">
        <p class="eyebrow">Portal público · primeira edição</p>
        <h1>Codex de<br /><em>Árborius</em></h1>
        <p>
          Um arquivo vivo para consultar regras, atravessar os guias e preservar
          a memória pública da campanha.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={withBase("biblioteca/guia-arboriano/", base)}>
            Continuar leitura <span aria-hidden="true">→</span>
          </a>
          <a class="button" href={withBase("compendio/", base)}>Explorar compêndio</a>
        </div>
      </div>
      <div class="hero-panel__folio" aria-label="Resumo da biblioteca">
        <span>Arquivo 01</span>
        <strong>{guides.length}</strong>
        <p>guias públicos<br />nesta edição</p>
        <div class="folio-lines" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
    </section>

    <section class="campaign-strip" aria-labelledby="agora-na-campanha">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Painel narrativo</p>
          <h2 id="agora-na-campanha">Agora na campanha</h2>
        </div>
        <p class="demo-note">Entradas demonstrativas, claramente marcadas.</p>
      </div>
      <div class="campaign-grid">
        {sessions[0] ? (
          <SessionCard
            title={sessions[0].data.title}
            number={sessions[0].data.number}
            date={sessions[0].data.date}
            description={sessions[0].data.description}
            example={sessions[0].data.example}
          />
        ) : (
          <article class="timeline-card"><p class="card-eyebrow">Última sessão</p><h3>Nenhuma crônica publicada</h3></article>
        )}
        {quests[0] ? (
          <QuestCard
            title={quests[0].data.title}
            state={quests[0].data.state}
            description={quests[0].data.description}
            example={quests[0].data.example}
          />
        ) : (
          <article class="timeline-card"><NavigationIcon name="quests" size="large" /><p class="card-eyebrow">Quest ativa</p><h3>Nenhuma quest publicada</h3></article>
        )}
        <article class="timeline-card timeline-card--empty">
          <NavigationIcon name="mundo" size="large" />
          <div class="card-eyebrow"><span>Última descoberta</span><span class="example-label">Estado vazio</span></div>
          <h3>Aguardando catalogação</h3>
          <p>Descobertas públicas aparecerão aqui sem antecipar lore da campanha.</p>
        </article>
        <article class="timeline-card timeline-card--empty">
          <NavigationIcon name="compendio" size="large" />
          <div class="card-eyebrow"><span>Item recente</span><span class="example-label">Estado vazio</span></div>
          <h3>Nenhum registro recente</h3>
          <p>Novos itens do compêndio serão destacados quando publicados.</p>
        </article>
      </div>
    </section>

    <section class="home-library" aria-labelledby="leitura-destacada">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Biblioteca</p>
          <h2 id="leitura-destacada">Leitura destacada</h2>
        </div>
        <a class="text-link" href={withBase("biblioteca/", base)}>Ver todos os guias →</a>
      </div>
      <div class="guide-list">
        {
          guides.slice(0, 2).map((guide, index) => (
            <GuideCard
              title={guide.data.title}
              slug={guide.data.slug}
              description={guide.data.description}
              tags={guide.data.tags}
              status={guide.data.status}
              updated={guide.data.updated}
              exports={guide.data.exports}
              index={index}
            />
          ))
        }
      </div>
    </section>

    <section class="player-guides" aria-labelledby="guias-dos-jogadores">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Maestrias · Dossiês de campanha</p>
          <h2 id="guias-dos-jogadores">Guias dos jogadores</h2>
        </div>
        <p class="player-guides__hint">Os sete caminhos disponíveis para leitura. As atualizações de Apolo usam a economia PO/PM em playtest.</p>
      </div>
      <div class="player-guide-grid">
          <a class="player-guide-card" href={withBase("dossies/apolo-hellman-f943e1efaaa2.html", base)}>
            <span class="player-guide-card__number" aria-hidden="true"><img src={withBase("symbols/maestria-araucaria-coroa.svg", base)} alt="" loading="lazy" width="44" height="44" /><small>I</small></span>
            <span class="player-guide-card__copy"><strong>Apolo Hellman</strong><small>Capítulo com habilidades e regras interligadas · Maestrias I–III</small></span>
            <span class="player-guide-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="player-guide-card" href={withBase("dossies/aruana-guardia-da-vida-6c9d83e2.html", base)}>
            <span class="player-guide-card__number" aria-hidden="true"><img src={withBase("symbols/maestria-araucaria-coroa.svg", base)} alt="" loading="lazy" width="44" height="44" /><small>II</small></span>
            <span class="player-guide-card__copy"><strong>Aruana</strong><small>Comunhão Natural · Bênção de Ártemis · Herança Runaespinho</small></span>
            <span class="player-guide-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="player-guide-card" href={withBase("dossies/brandon-tres-maestrias-e7c4b28a.html", base)}>
            <span class="player-guide-card__number" aria-hidden="true"><img src={withBase("symbols/maestria-araucaria-coroa.svg", base)} alt="" loading="lazy" width="44" height="44" /><small>III</small></span>
            <span class="player-guide-card__copy"><strong>Brandon</strong><small>Ressonância Empática · Lâmina Hemática · Dragoaria Arboriana</small></span>
            <span class="player-guide-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="player-guide-card" href={withBase("dossies/ekhyos-bardo-de-batalha-ef7c39a2.html", base)}>
            <span class="player-guide-card__number" aria-hidden="true"><img src={withBase("symbols/maestria-araucaria-coroa.svg", base)} alt="" loading="lazy" width="44" height="44" /><small>IV</small></span>
            <span class="player-guide-card__copy"><strong>Ekhyos</strong><small>Bardo de Batalha · Einherjar · Saga dos Vivos</small></span>
            <span class="player-guide-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="player-guide-card" href={withBase("dossies/jose-ramos-lopes-paladar-da-sobrevivencia-b73f0a82.html", base)}>
            <span class="player-guide-card__number" aria-hidden="true"><img src={withBase("symbols/maestria-araucaria-coroa.svg", base)} alt="" loading="lazy" width="44" height="44" /><small>V</small></span>
            <span class="player-guide-card__copy"><strong>José Ramos Lopes</strong><small>Paladar da Sobrevivência · Alquimia Caótica · Medicina da Assimilação</small></span>
            <span class="player-guide-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="player-guide-card" href={withBase("dossies/ludmila-gatozzo-artesa-das-folhas-c83f19a4.html", base)}>
            <span class="player-guide-card__number" aria-hidden="true"><img src={withBase("symbols/maestria-araucaria-coroa.svg", base)} alt="" loading="lazy" width="44" height="44" /><small>VI</small></span>
            <span class="player-guide-card__copy"><strong>Ludmila Gatozzo</strong><small>Artesã das Folhas · Tecelã do Vivo · Caçadora Silenciosa</small></span>
            <span class="player-guide-card__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="player-guide-card" href={withBase("dossies/vespasiano-varotto-tres-maestrias-9d62f1c8.html", base)}>
            <span class="player-guide-card__number" aria-hidden="true"><img src={withBase("symbols/maestria-araucaria-coroa.svg", base)} alt="" loading="lazy" width="44" height="44" /><small>VII</small></span>
            <span class="player-guide-card__copy"><strong>Vespasiano Varotto</strong><small>Engenharia Biológica · Visão Horrenda · Gênese Assimilada</small></span>
            <span class="player-guide-card__arrow" aria-hidden="true">↗</span>
          </a>
      </div>
    </section>

    <section class="section-directory" aria-labelledby="diretorio">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Diretório</p>
          <h2 id="diretorio">Explore o Codex</h2>
        </div>
      </div>
      <div class="directory-grid">
        {
          sections.map(([path, title, description, icon]) => (
            <a class="directory-card" href={withBase(path, base)}>
              <span><NavigationIcon name={icon} /></span>
              <h3>{title}</h3>
              <p>{description}</p>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</PortalLayout>
