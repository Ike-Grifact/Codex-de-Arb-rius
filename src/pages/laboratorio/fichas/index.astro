---
import PortalLayout from "../../../layouts/PortalLayout.astro";
import BetaBadge from "../../../components/BetaBadge.astro";
---

<PortalLayout title="Criação de fichas — Beta" description="Estrutura experimental local para fichas.">
  <div class="page-container narrow-page">
    <p class="eyebrow">Laboratório <BetaBadge /></p>
    <h1>Criação de fichas</h1>
    <div class="empty-state">
      <h3>Protótipo ainda não migrado</h3>
      <p>A ficha completa, o salvamento final e qualquer integração externa permanecem fora desta primeira entrega.</p>
    </div>
    <p class="local-warning">Recurso experimental. Os dados permanecem apenas neste navegador.</p>
  </div>
</PortalLayout>
