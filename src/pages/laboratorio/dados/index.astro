---
import PortalLayout from "../../../layouts/PortalLayout.astro";
import BetaBadge from "../../../components/BetaBadge.astro";
---

<PortalLayout title="Rolador de dados — Beta" description="Estrutura experimental local para rolagens.">
  <div class="page-container narrow-page">
    <p class="eyebrow">Laboratório <BetaBadge /></p>
    <h1>Rolador de dados</h1>
    <div class="empty-state">
      <h3>Protótipo ainda não migrado</h3>
      <p>Nenhum VTT, conta, integração com Foundry ou persistência em servidor foi implementado.</p>
    </div>
    <p class="local-warning">Recurso experimental. Os dados permanecem apenas neste navegador.</p>
  </div>
</PortalLayout>
