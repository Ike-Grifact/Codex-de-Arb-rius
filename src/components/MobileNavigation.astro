---
import { withBase } from "../lib/paths";
import NavigationIcon from "./NavigationIcon.astro";
const base = import.meta.env.BASE_URL;
const links = [
  ["", "Início", "inicio"],
  ["biblioteca/", "Biblioteca", "biblioteca"],
  ["compendio/", "Compêndio", "compendio"],
  ["buscar/", "Buscar", "busca"]
] as const;
---

<nav class="mobile-navigation no-print" aria-label="Navegação móvel">
  {
    links.map(([path, label, icon]) => (
      <a href={withBase(path, base)}>
        <NavigationIcon name={icon} />
        <small>{label}</small>
      </a>
    ))
  }
</nav>
