---
import { withBase } from "../lib/paths";
const base = import.meta.env.BASE_URL;
const links = [
  ["", "Início", "⌂"],
  ["biblioteca/", "Biblioteca", "▤"],
  ["compendio/", "Compêndio", "◇"],
  ["buscar/", "Buscar", "⌕"]
];
---

<nav class="mobile-navigation no-print" aria-label="Navegação móvel">
  {
    links.map(([path, label, icon]) => (
      <a href={withBase(path, base)}>
        <span aria-hidden="true">{icon}</span>
        <small>{label}</small>
      </a>
    ))
  }
</nav>
