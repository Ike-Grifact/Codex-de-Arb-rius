---
import { withBase } from "../lib/paths";
import NavigationIcon from "./NavigationIcon.astro";
const base = import.meta.env.BASE_URL;
---

<header class="app-header no-print">
  <a class="brand" href={withBase("", base)} aria-label="Codex de Árborius — página inicial">
    <span class="brand__mark"><NavigationIcon name="inicio" /></span>
    <span>
      <strong>Codex de Árborius</strong>
      <small>Arquivo vivo da campanha</small>
    </span>
  </a>
  <nav class="header-nav" aria-label="Navegação principal">
    <a href={withBase("biblioteca/", base)}>Biblioteca</a>
    <a href={withBase("compendio/", base)}>Compêndio</a>
    <a href={withBase("mundo/", base)}>Mundo</a>
    <a href={withBase("cronicas/", base)}>Crônicas</a>
  </nav>
  <a class="search-link" href={withBase("buscar/", base)}>
    <NavigationIcon name="busca" />
    <span>Buscar</span>
  </a>
</header>
