---
import { withBase } from "../lib/paths";
import { gameSymbolText, symbols } from "../data/game-symbols.mjs";

interface Props {
  type:
    | "sucesso"
    | "adaptacao"
    | "pressao"
    | "niveldedeterminacao"
    | "pontodedeterminacao"
    | "niveldeassimilacao"
    | "pontodeassimilacao"
    | "niveldesaude"
    | "pontodesaude"
    | "d6"
    | "d10"
    | "d12";
  count?: number | string;
  label?: boolean | string;
  size?: "small" | "normal" | "large";
}

const {
  type,
  count,
  label = false,
  size = "normal"
} = Astro.props;

const symbol = symbols[type];
const numericCount = count === undefined ? undefined : Number(count);
const ariaLabel = gameSymbolText(type, numericCount);
const readableLabel = typeof label === "string" ? label : symbol.label;
---

<span
  class:list={["game-symbol", `game-symbol--${size}`]}
  role="img"
  aria-label={ariaLabel}
  title={ariaLabel}
>
  {count !== undefined && <strong>{count}</strong>}
  <img
    src={withBase(`symbols/${symbol.file}`, import.meta.env.BASE_URL)}
    alt=""
    title={ariaLabel}
    width="22"
    height="22"
    decoding="async"
  />
  {label && <span>{readableLabel}</span>}
</span>
