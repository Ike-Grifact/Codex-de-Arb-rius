---
import {referenciasArborius,tiposReferencia} from "../data/arborius-references.mjs";
import {withBase} from "../lib/paths";
const {current=""}=Astro.props;
const base=import.meta.env.BASE_URL;
const groups=["acao","regra","recurso","procedimento"];
---
<aside class="rule-sidebar" aria-label="Navegação do Livro de Regras">
<a class="rule-brand" href={withBase("maestrias/apolo/capitulo/",base)}><img src={withBase("symbols/maestria-araucaria-coroa.svg",base)} alt=""/><span><strong>Codex de Árborius</strong><small>Regras interligadas · Apolo</small></span></a>
<p class="rule-sidebar-title">Livro e referências</p>
<nav class="rule-nav">
<div class="rule-nav-group"><h2>Capítulo de Apolo</h2>
<a href={withBase("maestrias/apolo/capitulo/",base)} aria-current={current==="capitulo"?"page":undefined}>I–III · Maestrias de Apolo</a>
<a href={withBase("maestrias/apolo/",base)}>Fichas das 15 capacidades</a></div>
{groups.map(type=><div class="rule-nav-group"><h2>{{acao:"Ações",regra:"Regras",recurso:"Recursos",procedimento:"Procedimentos"}[type]}</h2>
{referenciasArborius.filter(e=>e.type===type).map(e=><a href={withBase(`regras/${e.slug}/`,base)} aria-current={current===e.slug?"page":undefined}>{e.title}</a>)}
</div>)}
</nav></aside>