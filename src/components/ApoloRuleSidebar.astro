---
import {apoloMaestrias, apoloGrupos} from "../data/apolo-maestrias.mjs";
import {withBase} from "../lib/paths";
const {current=""}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<aside class="rule-sidebar" aria-label="Navegação das fichas de Apolo">
  <a class="rule-brand" href={withBase("maestrias/apolo/",base)}><img src={withBase("symbols/maestria-araucaria-coroa.svg",base)} alt=""/><span><strong>Codex de Árborius</strong><small>Maestrias · Apolo Hellman</small></span></a>
  <p class="rule-sidebar-title">Compêndio de capacidades</p>
  <nav class="rule-nav" aria-label="Capacidades por Maestria">
  <div class="rule-nav-group"><h2>Livro e referências</h2><a href={withBase("dossies/apolo-hellman-f943e1efaaa2.html",base)}>Dossiê ilustrado · Maestrias</a><a href={withBase("regras/",base)}>Ações, regras e recursos</a></div>
    {apoloGrupos.map(grupo=>(
    <div class="rule-nav-group">
      <h2>{grupo.name}</h2>
      {apoloMaestrias.filter(cap=>cap.stage===grupo.stage).map(cap=><a href={withBase(`maestrias/apolo/${cap.slug}/`,base)} aria-current={current===cap.slug?"page":undefined}>{cap.name}</a>)}
    </div>
  ))}
  </nav>
</aside>