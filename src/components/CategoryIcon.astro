---
import {
  categoryIconName,
  categoryIconPaths
} from "../data/category-icons";

interface Props {
  name?: string | number;
  label?: string;
  size?: "small" | "normal" | "large";
}

const { name = "item", label, size = "normal" } = Astro.props;
const iconName = categoryIconName(name);
---

<svg
  class:list={["category-icon", `category-icon--${size}`]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={categoryIconPaths[iconName]}
/>
