---
import { withBase } from "../lib/paths";
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const links = [
  ["", "Visão geral", "⌂"],
  ["biblioteca/", "Biblioteca", "▤"],
  ["compendio/", "Compêndio", "◇"],
  ["mundo/", "Mundo", "◎"],
  ["quests/", "Quests", "→"],
  ["cronicas/", "Crônicas", "◷"],
  ["laboratorio/", "Laboratório", "△"],
  ["assimilador/", "Assimilador", "◆"]
];
---

<aside class="app-sidebar no-print" aria-label="Seções do portal">
  <p class="sidebar-label">Portal da campanha</p>
  <nav>
    {
      links.map(([path, label, icon]) => {
        const href = withBase(path, base);
        const active =
          path === ""
            ? pathname === base || pathname === base.replace(/\/$/, "")
            : pathname.startsWith(href);
        return (
          <a href={href} aria-current={active ? "page" : undefined}>
            <span aria-hidden="true">{icon}</span>
            {label}
          </a>
        );
      })
    }
  </nav>
  <div class="sidebar-note">
    <span class="status-dot" aria-hidden="true"></span>
    <p><strong>Portal público</strong><br />Conteúdo reservado não é publicado.</p>
  </div>
</aside>
